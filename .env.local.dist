# Example of local, uncommitted overrides. Copy to .env.local and adjust.
# APP_SECRET=<random 64-hex string, e.g. from: php -r 'echo bin2hex(random_bytes(32));'>
# DATABASE_URL="sqlite:///%kernel.project_dir%/var/data/app.db"
#
# Docker Compose variables (shell env or a ".env"-style file passed with --env-file):
# APP_PORT=8089
# APP_SECRET=...   # optional; when empty the container generates one and stores it in the data volume
