{# HTMX fragment: returned alone by POST /tech/demo/ping and swapped in place (outerHTML). #}
<section id="ping-panel" class="rounded-lg bg-white p-4 shadow" data-testid="ping-panel">
    <h2 class="mb-2 font-semibold">3. HTMX — запис у SQLite та оновлення фрагмента</h2>
    <form method="post"
          action="{{ path('tech_demo_ping') }}"
          hx-post="{{ path('tech_demo_ping') }}"
          hx-target="#ping-panel"
          hx-swap="outerHTML"
          class="flex items-center gap-3">
        <input type="hidden" name="_token" value="{{ csrf_token('tech_demo_ping') }}">
        <button type="submit"
                class="rounded bg-indigo-600 px-3 py-1 text-sm text-white hover:bg-indigo-700"
                data-testid="ping-button">
            Записати ping
        </button>
        <span class="text-sm">Усього ping-ів: <strong data-testid="ping-count">{{ ping_count }}</strong></span>
        <span class="text-xs text-slate-500">фрагмент відрендерено о <span data-testid="ping-rendered-at">{{ rendered_at|date('H:i:s.v') }}</span></span>
    </form>
    <ul class="mt-2 text-xs text-slate-600" data-testid="ping-list">
        {% for ping in latest_pings %}
            <li>#{{ ping.id }} — {{ ping.createdAt|date('Y-m-d H:i:s') }} UTC</li>
        {% else %}
            <li>Ще немає записів.</li>
        {% endfor %}
    </ul>
    <template data-chart-update="ping-chart"
              data-chart-labels="{{ chart.labels|json_encode }}"
              data-chart-values="{{ chart.data|json_encode }}"></template>
</section>
