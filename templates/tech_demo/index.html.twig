{# TEMPORARY technical page proving the stack. No product design. #}
{% extends 'base.html.twig' %}

{% block title %}Stack demo — Expense Manager{% endblock %}
{% block body_class %}min-h-screen bg-slate-100 text-slate-900 antialiased{% endblock %}

{% block body %}
<main class="mx-auto max-w-4xl space-y-6 p-6" data-testid="tech-demo">
    <header>
        <p class="text-xs font-semibold uppercase tracking-wide text-amber-700">Технічна сторінка (тимчасова)</p>
        <h1 class="text-2xl font-bold" data-testid="tailwind-probe">Expense Manager — перевірка стеку</h1>
        <p class="text-sm text-slate-600">Symfony {{ constant('Symfony\\Component\\HttpKernel\\Kernel::VERSION') }} · PHP {{ constant('PHP_VERSION') }} · SQLite {{ sqlite_version }}</p>
    </header>

    <section class="grid gap-4 md:grid-cols-2">
        <div class="rounded-lg bg-white p-4 shadow">
            <h2 class="mb-2 font-semibold">1. SQLite + Doctrine</h2>
            <dl class="text-sm">
                <div class="flex justify-between"><dt>Версія SQLite</dt><dd data-testid="sqlite-version">{{ sqlite_version }}</dd></div>
                <div class="flex justify-between"><dt>Користувачів у БД</dt><dd data-testid="user-count">{{ user_count }}</dd></div>
            </dl>
        </div>

        <div class="rounded-lg bg-white p-4 shadow"
             x-data="{ open: false, clicks: 0 }"
             data-testid="alpine-demo">
            <h2 class="mb-2 font-semibold">2. Alpine.js</h2>
            <button type="button"
                    class="rounded bg-emerald-600 px-3 py-1 text-sm text-white hover:bg-emerald-700"
                    @click="open = !open; clicks++"
                    data-testid="alpine-toggle">
                Перемкнути
            </button>
            <span class="ml-2 text-sm">Кліків: <span x-text="clicks" data-testid="alpine-clicks">0</span></span>
            <p x-show="open" x-cloak class="mt-2 text-sm text-emerald-700" data-testid="alpine-panel">Alpine-компонент працює.</p>
        </div>
    </section>

    {{ include('tech_demo/_ping_panel.html.twig') }}

    <section class="rounded-lg bg-white p-4 shadow">
        <h2 class="mb-2 font-semibold">4. Chart.js — ping-и за хвилину (останні 10 хв, дані з SQLite)</h2>
        <div class="relative h-64">
            <canvas data-chart="bar"
                    data-chart-id="ping-chart"
                    data-chart-label="Ping-и"
                    data-chart-labels="{{ chart.labels|json_encode }}"
                    data-chart-values="{{ chart.data|json_encode }}"
                    data-testid="ping-chart"
                    aria-label="Графік ping-ів за хвилину"
                    role="img"></canvas>
        </div>
    </section>
</main>
{% endblock %}
