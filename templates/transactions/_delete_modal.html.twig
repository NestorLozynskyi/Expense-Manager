{# Delete confirmation (design "Delete this transaction?"). Vars: tx, page #}
{% import '_macros/ui.html.twig' as ui %}
{% set url = path('app_transaction_delete', {id: tx.id}) %}
{% set c = tx.category %}
<div class="modal modal--sm modal--confirm" id="confirm-delete" role="dialog" aria-modal="true" aria-labelledby="cd-title" aria-describedby="cd-desc" data-dispose data-open-on-load{% if not (page ?? false) %} hidden{% endif %}>
    <div class="modal__overlay" data-close-modal></div>
    <form class="modal__dialog" method="post" action="{{ url }}" hx-post="{{ url }}">
        <input type="hidden" name="_token" value="{{ csrf_token('delete-transaction-' ~ tx.id) }}">
        <div class="modal__header"><span class="modal__icon modal__icon--danger">{{ icon('trash', 20) }}</span>
            <div class="modal__heading"><h2 class="modal__title" id="cd-title">Delete this transaction?</h2>
                <p class="modal__desc" id="cd-desc">“{{ tx.note ?: c.name }}”, {{ tx.amountMinor|money_signed(tx.type.value) }} on {{ tx.date|date_short }}. This can’t be undone.</p></div>
            <button type="button" class="btn btn--ghost btn--icon btn--sm modal__close" data-close-modal aria-label="Close">{{ icon('x', 20) }}</button></div>
        <div class="modal__body">
            <dl class="tx-dl">
                <dt>Date</dt><dd>{{ tx.date|date_medium }}</dd>
                <dt>Category</dt><dd>{{ ui.cat_chip(c) }}</dd>
                <dt>Amount</dt><dd>{{ ui.amount(tx.amountMinor, tx.type.value) }}</dd>
                <dt>Note</dt><dd>{{ tx.note ?: '—' }}</dd>
            </dl>
        </div>
        <div class="modal__footer"><button type="button" class="btn btn--secondary" data-close-modal>Cancel</button><button type="submit" class="btn btn--danger" id="cd-confirm" data-autofocus data-loading-label="Deleting…">Delete</button></div>
    </form>
</div>
